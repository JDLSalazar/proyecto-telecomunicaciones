# Copia este archivo a /etc/prepago.env, cambia los valores y ejecuta: sudo chmod 600 /etc/prepago.env
# Contraseña del usuario "radius" de MariaDB.
DB_PASS=CAMBIAR_CLAVE_BD
# Clave para entrar al dashboard: /dashboard?key=ESTA_CLAVE
DASH_TOKEN=CAMBIAR_CLAVE_DASHBOARD
# IP de pfSense en la VLAN 30.
PFSENSE_IP=10.30.0.1
# Comunidad SNMP de pfSense (vacía hasta que A active SNMP).
SNMP_COMMUNITY=
# Interfaz de pfSense que mide el dashboard.
SNMP_IFACE=em2
# Interfaz de esta VM: enp0s8 en desarrollo, vlan30 tras la integración.
NET_IFACE=vlan30
PFSENSE_IP6=fd00:0:0:30::1
